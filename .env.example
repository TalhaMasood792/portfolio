# Optional. Add these in Vercel > Project > Settings > Environment Variables
# to make the "Ask about my work" chat use a real AI model.
# Without them, the chat answers from data/profile.js in the browser.
AI_API_KEY=your-api-key-here
# Groq (free tier):   AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.1-8b-instant
# Gemini (free tier): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.0-flash
# OpenAI:             AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
